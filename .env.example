# ==============================================================================
# InnoFlow - Environment Variables Blueprint
# ==============================================================================

# Database Configuration (MySQL)
DB_HOST=localhost
DB_PORT=3306
DB_NAME=campus_research_db
DB_USER=innoflow_user
DB_PASSWORD=innoflow_password
DB_ROOT_PASSWORD=rootpassword

# Spring Boot Backend Service
PORT=8080
SPRING_PROFILES_ACTIVE=prod
SPRING_DATASOURCE_URL=jdbc:mysql://localhost:3306/campus_research_db?useSSL=false&serverTimezone=UTC&allowPublicKeyRetrieval=true&createDatabaseIfNotExist=true
SPRING_DATASOURCE_USERNAME=innoflow_user
SPRING_DATASOURCE_PASSWORD=innoflow_password

# React Frontend Configuration
FRONTEND_PORT=3000
VITE_API_URL=http://localhost:8080
